output "id" {
  description = "Unique identifier of the OpenSearch application."
  value       = try(aws_opensearch_application.this[0].id, null)
}

output "arn" {
  description = "ARN of the OpenSearch application."
  value       = try(aws_opensearch_application.this[0].arn, null)
}

output "name" {
  description = "Name of the OpenSearch application."
  value       = try(aws_opensearch_application.this[0].name, null)
}

output "endpoint" {
  description = "Endpoint URL of the OpenSearch application."
  value       = try(aws_opensearch_application.this[0].endpoint, null)
}

output "iam_identity_center_application_arn" {
  description = "ARN of the IAM Identity Center application generated by OpenSearch."
  value       = try(aws_opensearch_application.this[0].iam_identity_center_options[0].iam_identity_center_application_arn, null)
}

output "identity_center_role_arn" {
  description = "ARN of the module-managed or externally supplied Identity Center role."
  value       = local.identity_center_role_arn
}

output "application" {
  description = "OpenSearch application resource object."
  value       = try(aws_opensearch_application.this[0], null)
}